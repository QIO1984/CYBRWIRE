# Copy to cybrwire.env and fill in. Never commit cybrwire.env (it is git-ignored).
# Lock it down:  chmod 600 cybrwire.env

# Sign-in (required: the container listens on the network)
CYBRWIRE_WEB_PASSWORD=change-me-to-something-long
# CYBRWIRE_WEB_USER=cybrwire

# Your time zone for the clock (name from the tz database, e.g. Europe/London)
TZ=America/New_York

# World clock cities: comma-separated CODE:Zone pairs, replacing the defaults (shown here).
# Uncomment and edit. Zone names are tz database names, so any city works.
# CYBRWIRE_CLOCKS=LAX:America/Los_Angeles,NYC:America/New_York,LON:Europe/London,ROM:Europe/Rome,SPB:Europe/Moscow,TYO:Asia/Tokyo
# One prominent city per time zone, west to east, to copy from:
#   HNL:Pacific/Honolulu ANC:America/Anchorage LAX:America/Los_Angeles DEN:America/Denver
#   CHI:America/Chicago NYC:America/New_York SAO:America/Sao_Paulo UTC:UTC
#   LON:Europe/London ROM:Europe/Rome CAI:Africa/Cairo SPB:Europe/Moscow THR:Asia/Tehran
#   DXB:Asia/Dubai KHI:Asia/Karachi DEL:Asia/Kolkata DAC:Asia/Dhaka BKK:Asia/Bangkok
#   SHA:Asia/Shanghai TYO:Asia/Tokyo SYD:Australia/Sydney AKL:Pacific/Auckland

# Keys: fill in only what you use. Anything left blank is ignored.
# AI briefings (pick your provider; choose the model in the app with Shift+K)
CYBRWIRE_ANTHROPIC_API_KEY=
# CYBRWIRE_GEMINI_API_KEY=
# CYBRWIRE_OPENAI_API_KEY=
# CYBRWIRE_OPENROUTER_API_KEY=

# Enrichment and feeds
# CYBRWIRE_NVD_API_KEY=
# CYBRWIRE_ABUSEIPDB_API_KEY=
# CYBRWIRE_VIRUSTOTAL_API_KEY=
# CYBRWIRE_PULSEDIVE_API_KEY=
# CYBRWIRE_ABUSE_CH_API_KEY=

# Notifications
# CYBRWIRE_PUSHOVER_TOKEN=
# CYBRWIRE_PUSHOVER_USER=
# CYBRWIRE_NTFY_URL=
# CYBRWIRE_NTFY_TOKEN=
# CYBRWIRE_TELEGRAM_TOKEN=
# CYBRWIRE_TELEGRAM_CHAT_ID=
# CYBRWIRE_DISCORD_WEBHOOK=
# CYBRWIRE_SLACK_WEBHOOK=
